# Scheduled pg_dump backup sidecar.
#
# Uses the postgres:18 client so pg_dump matches the PostgreSQL 18 server MAJOR version — a lower
# pg_dump (e.g. the Debian 13 client, version 17, in the backend/worker images) aborts with "server
# version mismatch" and would silently never produce a backup. aws-cli is for the optional S3 copy.
FROM postgres:18-alpine@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5

RUN apk add --no-cache aws-cli

COPY scripts/backup_loop.sh /usr/local/bin/backup_loop.sh
RUN chmod +x /usr/local/bin/backup_loop.sh

# Override the postgres image's entrypoint (which expects to initialize/run a server) so our loop
# runs directly. The sidecar only connects out via DATABASE_URL and writes to /backups.
ENTRYPOINT []
CMD ["/usr/local/bin/backup_loop.sh"]

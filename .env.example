# Freedom Ridge Environment Configuration
#
# Copy to .env and edit for your deployment. Lines starting with # are
# optional — Freedom Ridge uses sensible defaults where possible.
#
# Required vars are marked [REQUIRED]. Everything else has a working default
# for local development. For production, review the [PRODUCTION] notes.

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL credentials for the Docker container.
POSTGRES_USER=freedomridge
POSTGRES_PASSWORD=password           # [PRODUCTION] Change this!
POSTGRES_DB=freedomridge

# Full connection string. If set, overrides POSTGRES_* vars above.
# DATABASE_URL=postgres://freedomridge:password@localhost:5432/freedomridge

# Compose project name. Keep this pinned.
#
# docker-compose derives the project name from the DIRECTORY name, and the project
# name is what prefixes the named volume holding your database. If you rename the
# checkout directory, `docker-compose up -d` creates a NEW EMPTY volume, initdb-seeds
# it from schema.sql, and the app comes up looking perfectly healthy while your real
# data sits in an orphaned volume. Pinning this decouples the volume from the
# directory name.
#
# Set it before the first `up`, and do not change it afterwards without migrating the
# volume. (docker-compose v1 has no top-level `name:` key — this variable is the fix.)
COMPOSE_PROJECT_NAME=freedomridge
# For a second copy, choose a different project, container names, and host port.
# Keep the defaults for an existing installation.
# FRIDGE_DB_CONTAINER=freedomridge-db
# FRIDGE_DB_PORT=5432
# FRIDGE_WORKER_CONTAINER=freedomridge-worker

# ============================================================================
# STORAGE
# ============================================================================

# Storage backend: "local" (serve files from FRIDGE_DATA_ROOT) or "s3"
# STORAGE_TYPE=local

# Local file directory. Used both as the media root for local-mode datasets
# and as the path-containment boundary for the /api/samples/{id}/media proxy.
# FRIDGE_DATA_ROOT=./data

# Host-side data volume for Docker deployments (mounted into containers).
# DATA_VOLUME_PATH=./data

# --- S3 configuration (when STORAGE_TYPE=s3 or per-dataset via the UI) ---
# If using the UI-based storage configs (recommended), these are only needed
# as a fallback for datasets that haven't been assigned a storage config yet.
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=                  # Or use ~/.aws/credentials
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=                   # For MinIO or other S3-compatible storage

# Local cache for S3 images. On first fetch the image is downloaded from S3
# and saved here; subsequent requests serve from disk (no S3 hit).
# S3_LOCAL_CACHE_PATH=/tmp/freedomridge-s3-cache

# The folder database backups go to. Set it, restart, then choose a schedule on Settings → System status
# → Backups; the job runner runs scripts/backup_local.py into it. Unset: the card says "not set up".
# FRIDGE_BACKUP_DIR=/path/to/backups

# ============================================================================
# SECURITY
# ============================================================================

# Deployment environment. Leave as "development" locally. Set to "production"
# for any shared/cloud deploy: in production the backend REFUSES TO BOOT unless
# STORAGE_ENCRYPTION_KEY is a real (non-default) value — the safety gate that
# stops you shipping with stored S3 secrets encrypted under the public default.
# FRIDGE_ENV=development

# [PRODUCTION] Required on first boot while admin still has the seeded admin123 password.
# Must pass the password policy (at least 8 characters, not common or the default).
# Startup rotates the password and clears the forced-change flag; existing custom passwords stay.
# Also accepted by reset_admin.py for a non-interactive reset. Development keeps admin/admin123.
# FRIDGE_ADMIN_PASSWORD=

# Public/demo database budgets; inactive in ordinary development. No limit on result counts.
# FRIDGE_GUEST_STATEMENT_TIMEOUT_SECONDS=30
# FRIDGE_DB_ACQUIRE_TIMEOUT_SECONDS=5
# Maximum stored demo accounts, globally across API workers. Cleanup frees expired accounts' slots.
# FRIDGE_DEMO_ACCOUNT_CAP=2000
# In production or demo mode the existing job runner prunes day-old demo accounts (including views)
# and expired sessions every 5 minutes.

# Encryption key for storage-config secrets stored in the database. Uses
# Fernet (AES-128) with PBKDF2 key derivation.
# [PRODUCTION] REQUIRED when FRIDGE_ENV=production (boot fails otherwise).
# Anyone who knows the default can decrypt your stored S3 credentials, so
# generate a unique one:  python -c 'import secrets; print(secrets.token_urlsafe(48))'
# STORAGE_ENCRYPTION_KEY=

# Session idle timeout in hours. Active users get their session extended
# automatically (sliding window), so this is really how long a user can be
# IDLE before they need to log in again.
# SESSION_TTL_HOURS=24

# Send the session cookie only over HTTPS. Set true in production the moment TLS
# is terminating in front of nginx (see the nginx.conf 443 block and
# docs/DEPLOY_TO_AWS.md step 6). Leave false ONLY for local dev over plain HTTP —
# over HTTP a `true` value stops the browser returning the cookie, so logins
# appear to fail. Until TLS is up the session cookie travels in clear: acceptable
# for a throwaway demo, NOT for real accounts.
SESSION_COOKIE_SECURE=false

# ============================================================================
# CORS / NETWORKING
# ============================================================================

# Comma-separated origins allowed by CORS. Must include wherever the
# frontend is served from.
# For remote development, explicitly list each frontend host's origins, or opt in below.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Dev launcher only: discover peers on every launch and append their IP, short
# name and full MagicDNS name using FRIDGE_FRONTEND_PORT (default 3000).
# Discovery is OFF unless this value is exactly 1.
FRIDGE_TAILSCALE_ORIGINS=0
# Optional shell glob or space-separated globs matching peer short names.
# Quote multiple patterns. No peer names are skipped by default.
# FRIDGE_TAILSCALE_SKIP='build-* temporary-*'

# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# Mapbox token for map panel (GPS data visualization)
# NEXT_PUBLIC_MAPBOX_TOKEN=your_token_here

# Demo mode — adds a "Try as Guest" button on the login page that creates
# temporary guest accounts. Useful for public demos, NOT for production.
# DEMO_MODE=false

# Background cache eviction is enabled only in production/prod, DEMO_MODE, or
# when FRIDGE_CACHE_MAX_BYTES is explicitly set. It checks incremental counts
# every 15 minutes and only walks above budget. The hourly worker prune remains.
# FRIDGE_CACHE_MAX_BYTES=10737418240
# FRIDGE_CACHE_MAINTENANCE_SECONDS=900

# Sparse sampling defaults to 60 seconds only for DEMO_MODE guests. In production
# this explicit setting also budgets other roles. Local admins/power users have
# no time budget, even when this setting is present. Disconnects always cancel.
# FRIDGE_SAMPLING_BUDGET_SECONDS=60

# Local launcher starts one job runner alongside the API master by default.
# Disable only when a separate Docker job-runner service owns local execution.
# FRIDGE_RUNNER_ENABLED=true
# FRIDGE_BACKEND_HOST=0.0.0.0
# FRIDGE_BACKEND_PORT=8000
# JOB_WORKER_SLOTS=3
# JOB_POOL_MAX_SIZE=6
# Docker job-runner (docker-compose.prod.yml): its memory limit, within which map re-fits run, as the
# container has no systemd. Unset: no limit, and re-fits are skipped.
# JOB_RUNNER_MEMORY_LIMIT=24g
# JOB_SELECTION_CLEANUP_SECONDS=300
# JOB_SHUTDOWN_SECONDS=20
# FRIDGE_SHUTDOWN_SECONDS=30

# Public guest admission/storage/work budgets (validated at API startup).
# Guest saves remain private; these limits never truncate data returned by reads.
FRIDGE_DEMO_IP_HOURLY_LIMIT=5
FRIDGE_DEMO_IP_LIVE_CAP=10
# Trusted IPs/CIDRs, comma or whitespace separated; e.g. 203.0.113.0/24,2001:db8::/32
FRIDGE_DEMO_IP_ALLOWLIST=
FRIDGE_GUEST_VIEW_TOTAL_BYTES=2097152
FRIDGE_GUEST_VIEW_COUNT=200
FRIDGE_GUEST_CONCURRENCY=2

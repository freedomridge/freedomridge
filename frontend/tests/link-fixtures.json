{
  "about": [
    "Links that must keep opening (frontend/lib/links.ts). A change that breaks one either keeps reading the old",
    "form or drops it on purpose: remove its fixtures in the same change and say so in the CHANGELOG.",
    "q: query-language text; it opens on one chip per entry of filters (backend/tests/test_link_fixtures.py).",
    "f: encoded stages; it opens on stages (tests/links.test.cjs). Every filter here must still compile.",
    "fields: the field kinds the q links are parsed against. count: the samples a link opens on in the e2e",
    "fixture dataset (e2e/open-links.spec.ts)."
  ],
  "fields": {
    "id": "number",
    "filepath": "text",
    "split": "text",
    "idx": "number",
    "score": "number",
    "note": "text",
    "tags": "list",
    "sampled_at": "datetime",
    "ok": "boolean",
    "in": "text"
  },
  "q": [
    {
      "name": "= and !=",
      "q": "split = train AND idx != 3",
      "filters": [
        {
          "field": "split",
          "operator": "=",
          "value": "train"
        },
        {
          "field": "idx",
          "operator": "!=",
          "value": 3
        }
      ]
    },
    {
      "name": "> >= < <=",
      "q": "idx > 2 AND idx <= 8 AND score >= 1.5 AND score < 4",
      "filters": [
        {
          "field": "idx",
          "operator": ">",
          "value": 2
        },
        {
          "field": "idx",
          "operator": "<=",
          "value": 8
        },
        {
          "field": "score",
          "operator": ">=",
          "value": 1.5
        },
        {
          "field": "score",
          "operator": "<",
          "value": 4
        }
      ]
    },
    {
      "name": "in and not in",
      "q": "split in (train val) AND idx not in (0, 1, 2)",
      "filters": [
        {
          "field": "split",
          "operator": "in",
          "value": [
            "train",
            "val"
          ]
        },
        {
          "field": "idx",
          "operator": "not in",
          "value": [
            0,
            1,
            2
          ]
        }
      ]
    },
    {
      "name": "between",
      "q": "idx between 2 and 5",
      "filters": [
        {
          "logic": "AND",
          "filters": [
            {
              "field": "idx",
              "operator": ">=",
              "value": 2
            },
            {
              "field": "idx",
              "operator": "<=",
              "value": 5
            }
          ]
        }
      ]
    },
    {
      "name": "contains and like",
      "q": "filepath contains \"img_0\" AND tags like \"%mod3_1%\"",
      "filters": [
        {
          "field": "filepath",
          "operator": "contains",
          "value": "img_0"
        },
        {
          "field": "tags",
          "operator": "contains",
          "value": "mod3_1"
        }
      ]
    },
    {
      "name": "exists and not exists",
      "q": "split exists AND note not exists",
      "filters": [
        {
          "field": "split",
          "operator": "exists",
          "value": null
        },
        {
          "field": "note",
          "operator": "not_exists",
          "value": null
        }
      ]
    },
    {
      "name": "is null and is not null",
      "q": "note is null AND idx is not null",
      "filters": [
        {
          "field": "note",
          "operator": "is_null",
          "value": null
        },
        {
          "field": "idx",
          "operator": "is_not_null",
          "value": null
        }
      ]
    },
    {
      "name": "AND, OR, NOT and brackets",
      "q": "split = val AND NOT (idx >= 9 OR note exists)",
      "count": 3,
      "filters": [
        {
          "field": "split",
          "operator": "=",
          "value": "val"
        },
        {
          "logic": "NOT",
          "filters": [
            {
              "logic": "OR",
              "filters": [
                {
                  "field": "idx",
                  "operator": ">=",
                  "value": 9
                },
                {
                  "field": "note",
                  "operator": "exists",
                  "value": null
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "OR binds looser than AND: one chip",
      "q": "split = train AND idx < 2 OR idx > 10",
      "filters": [
        {
          "logic": "OR",
          "filters": [
            {
              "logic": "AND",
              "filters": [
                {
                  "field": "split",
                  "operator": "=",
                  "value": "train"
                },
                {
                  "field": "idx",
                  "operator": "<",
                  "value": 2
                }
              ]
            },
            {
              "field": "idx",
              "operator": ">",
              "value": 10
            }
          ]
        }
      ]
    },
    {
      "name": "dates",
      "q": "sampled_at >= 2024-01-05T00:00:00 AND sampled_at < \"2024-01-09\"",
      "filters": [
        {
          "field": "sampled_at",
          "operator": ">=",
          "value": "2024-01-05T00:00:00"
        },
        {
          "field": "sampled_at",
          "operator": "<",
          "value": "2024-01-09"
        }
      ]
    },
    {
      "name": "booleans",
      "q": "ok = true AND ok != false",
      "filters": [
        {
          "field": "ok",
          "operator": "=",
          "value": true
        },
        {
          "field": "ok",
          "operator": "!=",
          "value": false
        }
      ]
    },
    {
      "name": "other spellings and value forms",
      "q": "split == \"train\" AND idx <> 3 AND `in` = 'A \"b\"' AND idx in [1, 2]  # a comment",
      "filters": [
        {
          "field": "split",
          "operator": "=",
          "value": "train"
        },
        {
          "field": "idx",
          "operator": "!=",
          "value": 3
        },
        {
          "field": "in",
          "operator": "=",
          "value": "A \"b\""
        },
        {
          "field": "idx",
          "operator": "in",
          "value": [
            1,
            2
          ]
        }
      ]
    }
  ],

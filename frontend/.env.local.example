# ============================================
# Freedom Ridge Frontend Environment Configuration
# ============================================

# Only the map panel needs a free Mapbox public access token; everything else
# works without it. Create one at https://account.mapbox.com/access-tokens/.
# mapbox-gl 3.x is proprietary (non-OSS), subject to Mapbox terms, usage limits,
# and pricing: https://www.mapbox.com/legal/tos/ . See ../THIRD_PARTY_NOTICES.md.
# Use a public token with URL restrictions, never a secret token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: comma-separated hostnames/IPs allowed to load the development server.
# ALLOWED_DEV_ORIGINS=dev.example.test,192.0.2.10

# API routing
# -----------
# The browser always calls the relative /api path; the Next.js server proxies it
# to the backend. Point the proxy elsewhere with FRIDGE_BACKEND_URL (defaults to
# http://localhost:8000):
#   FRIDGE_BACKEND_URL=http://backend:8000
